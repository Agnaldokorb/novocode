# Prisma/PostgreSQL (prefer the direct connection for migrations)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:54322/postgres"

# Supabase server-side authentication. Local CLI aliases are also supported.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Private storage bucket. Keep this bucket private.
SUPABASE_DOCUMENTS_BUCKET="client-documents"

# One-time bootstrap values used by `npm run admin:create`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="Administrador"
